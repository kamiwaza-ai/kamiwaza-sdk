# Copy this file to .env.local and fill in the values to run integration tests locally.
# Values in .env.local override the process environment for pytest runs.

# Core service settings
DATAHUB_HOST=
KAFKA_BOOTSTRAP=
SECRET_ENCRYPTION_KEY=

# Cloudflare R2 credentials
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_KEY=
CLOUDFLARE_REGION=
CLOUDFLARE_ENDPOINT=

# AWS S3 profile
AWS_PROFILE=
AWS_REGION=
S3_TEST_BUCKET=

# Azure Blob / ADLS Gen2
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_BLOB_ENDPOINT=

# Postgres (CockroachDB)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Hive metastore
HIVE_METASTORE_URI=
HIVE_DATABASE=

# Slack test data
SLACK_TEST_TOKEN=
SLACK_TEST_TEAM=
SLACK_TEST_CHANNEL=

# Kafka metadata topic
KAFKA_TOPIC=

# Skills Library backing-store verification (ENG-11524).
# Required by the `requires_platform_store` live tests, which read the
# `skill_library` row and the stored package directly - the API exposes
# neither. All five must be set or those tests skip as a unit.
KAMIWAZA_SKILLS_STORE_DSN=
KAMIWAZA_SKILLS_STORE_S3_ENDPOINT_URL=
KAMIWAZA_SKILLS_STORE_S3_BUCKET=
KAMIWAZA_SKILLS_STORE_S3_ACCESS_KEY_ID=
KAMIWAZA_SKILLS_STORE_S3_SECRET_ACCESS_KEY=
# Optional; defaults to us-east-1.
KAMIWAZA_SKILLS_STORE_S3_REGION=
