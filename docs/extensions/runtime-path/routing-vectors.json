        "KAMIWAZA_ROUTING_MODE": "path",
        "KAMIWAZA_APP_PATH": "/runtime/apps/550e8400",
        "KAMIWAZA_APP_URL": "https://host.example:8443/"
      },
      "expect": {
        "routing_mode": "path",
        "app_path": "/runtime/apps/550e8400",
        "app_path_url": "",
        "app_url": "https://host.example:8443/runtime/apps/550e8400",
        "deployment_id": "",
        "app_port": ""
      }
    },
    {
