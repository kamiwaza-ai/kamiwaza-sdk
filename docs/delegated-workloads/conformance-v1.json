  "negative_guard_cases": [
    {
      "id": "wrong-token-class",
      "change": "Replace the dedicated effect capability with a member or run token.",
      "expected": {"status": 403, "error_code": "protected_resource_rejected", "handler_invoked": false}
    },
    {
      "id": "untrusted-issuer-or-key",
      "change": "Change iss, kid, signature, or use a private/untrusted JWKS member.",
      "expected": {"status": 403, "error_code": "protected_resource_rejected", "handler_invoked": false}
    },
    {
      "id": "wrong-audience-or-expired",
      "change": "Change aud or move exp/authority_deadline outside the valid window.",
      "expected": {"status": 403, "error_code": "protected_resource_rejected", "handler_invoked": false}
    },
    {
      "id": "invalid-dpop-or-request-digest",
      "change": "Change proof key, htm, htu, ath, body_sha256, iat, jti, or request bytes.",
      "expected": {"status": 403, "error_code": "protected_resource_rejected", "handler_invoked": false}
    },
    {
      "id": "descriptor-revision-drift",
      "change": "Change resource type, descriptor version, audience, action, or active registration revision.",
      "expected": {"status": 403, "error_code": "protected_resource_rejected", "handler_invoked": false}
    },
    {
      "id": "stale-claim-or-fence",
      "change": "Return a different run claim, fencing token, workload revision, or actor identity.",
      "expected": {"status": 403, "error_code": "protected_resource_rejected", "handler_invoked": false}
    },
    {
      "id": "current-decision-deny",
      "change": "Return deny, no requester context, or no one-use token from authorization.",
      "expected": {"status": 403, "error_code": "protected_resource_rejected", "handler_invoked": false}
    },
    {
      "id": "one-use-replay",
      "change": "Reuse the consumption token or return a state other than executing.",
      "expected": {"status": 403, "error_code": "protected_resource_rejected", "handler_invoked": false}
    },
    {
      "id": "spoofed-delegated-context",
      "change": "Add any inbound X-Kamiwaza-Delegated-* header or construct an unsealed context.",
      "expected": {"status": 403, "error_code": "protected_resource_rejected", "handler_invoked": false}
    }
  ],
