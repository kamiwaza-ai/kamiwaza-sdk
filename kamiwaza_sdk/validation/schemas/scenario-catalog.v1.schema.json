{
  "$comment": "JSON Schema enforces representable wire constraints; canonical SDK runtime model validation is required for cross-field identity, reference, journal, and status invariants that JSON Schema cannot express.",
  "$defs": {
    "FactMatcher": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "enum": [
            "eq",
            "in",
            "contains",
            "gte",
            "lte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "path": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n\\u2028\\u2029]"
            },
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Path",
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "path",
        "operator",
        "value"
      ],
      "title": "FactMatcher",
      "type": "object"
    },
    "JsonValue": {},
    "ScenarioDescriptor": {
      "additionalProperties": false,
      "properties": {
        "applies_when": {
          "items": {
            "$ref": "#/$defs/FactMatcher"
          },
          "title": "Applies When",
          "type": "array"
        },
        "capability_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n\\u2028\\u2029]"
            },
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "title": "Capability Ids",
          "type": "array"
        },
        "case_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n\\u2028\\u2029]"
            },
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Case Ids",
          "type": "array",
          "uniqueItems": true
        },
        "fixture_modes": {
          "items": {
            "enum": [
              "owned",
              "external"
            ],
            "type": "string"
          },
          "title": "Fixture Modes",
          "type": "array"
        },
        "minimum_level": {
          "enum": [
            "smoke",
            "standard",
            "comprehensive"
          ],
          "title": "Minimum Level",
          "type": "string"
        },
        "protocol_version": {
          "const": "v1",
          "title": "Protocol Version",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 256,
          "minLength": 1,
          "not": {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Provider Id",
          "type": "string"
        },
        "requires": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n\\u2028\\u2029]"
            },
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "scenario_id": {
          "maxLength": 256,
          "minLength": 1,
          "not": {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "target_scope": {
          "enum": [
            "cluster",
            "inference_target"
          ],
          "title": "Target Scope",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "provider_id",
        "protocol_version",
        "target_scope",
        "minimum_level",
        "capability_ids",
        "applies_when",
        "requires",
        "fixture_modes",
        "case_ids"
      ],
      "title": "ScenarioDescriptor",
      "type": "object"
    }
  },
  "$id": "kamiwaza.scenario-catalog/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Wire document emitted by the deterministic describe command.",
  "items": {
    "$ref": "#/$defs/ScenarioDescriptor"
  },
  "minItems": 1,
  "title": "ScenarioCatalog",
  "type": "array"
}
