{
  "$comment": "JSON Schema enforces representable wire constraints; canonical SDK runtime model validation is required for cross-field identity, reference, journal, and status invariants that JSON Schema cannot express.",
  "$defs": {
    "RuntimeCluster": {
      "additionalProperties": false,
      "properties": {
        "api_key_ref": {
          "maxLength": 4096,
          "not": {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          },
          "pattern": "^(?:secret|file)://[^\\s]+$",
          "title": "Api Key Ref",
          "type": "string"
        },
        "base_url": {
          "maxLength": 2048,
          "not": {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          },
          "pattern": "^https?://[^@\\s/]+(?:/[^\\s]*)?$",
          "title": "Base Url",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "not": {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Id",
          "type": "string"
        },
        "kubeconfig_ref": {
          "maxLength": 4096,
          "not": {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          },
          "pattern": "^file://[^\\s]+$",
          "title": "Kubeconfig Ref",
          "type": "string"
        }
      },
      "required": [
        "id",
        "base_url",
        "api_key_ref",
        "kubeconfig_ref"
      ],
      "title": "RuntimeCluster",
      "type": "object"
    }
  },
  "$id": "kamiwaza.runtime-context/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clusters": {
      "items": {
        "$ref": "#/$defs/RuntimeCluster"
      },
      "minItems": 1,
      "title": "Clusters",
      "type": "array",
      "uniqueItems": true
    },
    "ownership_key_ref": {
      "anyOf": [
        {
          "maxLength": 4096,
          "not": {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          },
          "pattern": "^(?:secret|file)://[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ownership Key Ref"
    },
    "run_id": {
      "maxLength": 256,
      "minLength": 1,
      "not": {
        "pattern": "[\\r\\n\\u2028\\u2029]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema": {
      "const": "kamiwaza.runtime-context/v1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "run_id",
    "clusters"
  ],
  "title": "RuntimeContext",
  "type": "object"
}
